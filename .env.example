# Database
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=
JWT_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 3rd Party Services
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SYSTEM_PROMPT=You are an Excel generation assistant. Input will be JSON from a parsed upload. Return ONLY valid JSON with shape {"status":"ok|error","summary":"string","sheets":[{"name":"string","columns":["string"],"rows":[{}]}],"validations":[{"sheet":"string","rule":"string","level":"info|warning|error"}],"errors":["string"]}. No markdown, no extra text.
LLM_CACHE_TTL_SECONDS=300

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Storage
# Paths relative to the backend working directory for local development.
MEDIA_ROOT=media
CSV_EXPORT_DIR=media/exports/csv
EXCEL_EXPORT_DIR=media/exports/excel

# OCR (Tesseract)
# Language(s) for OCR (must be installed in system)
# Examples:
#   eng        -> English only
#   ind        -> Indonesian only
#   eng+ind    -> multilingual
TESSERACT_LANG=eng+ind
